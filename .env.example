# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ── Auth service ──────────────────────────────────────────────────────────────
AUTH_SERVICE_URL=https://auth.expatevents.org

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_URL=https://expatevents.org

# ── Telegram bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sentry error tracking ─────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project → Settings → Client Keys
# Both server and client need separate DSNs if using different Sentry projects,
# or you can use the same DSN for both.
SENTRY_DSN=                     # Server-side (Node/Express)
VITE_SENTRY_DSN=                # Client-side (React, injected at build time)
